
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // NestJS compiles to CommonJS; the generator's default ESM output breaks at runtime.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}
enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model File {
  id           String   @id @default(uuid())
  originalName String
  storedName   String
  mimeType     String
  size         Int
  uploadedAt   DateTime @default(now())

  analysis       String?
  analysisStatus AnalysisStatus @default(PENDING)
  analysisError  String?
  analyzedAt     DateTime?

  @@index([analysisStatus])
}